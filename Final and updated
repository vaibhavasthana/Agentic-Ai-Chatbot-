def infer_geo_from_area(area: str) -> dict:
    """
    Uses Gemini's built-in world knowledge to resolve ANY location input
    (city / state / province / country) to a country name.
    Region is then mapped via COUNTRY_TO_REGION in Python — zero extra tokens.
    Total cost: 1 small Gemini call per Area input, nothing more.
    """
    prompt = (
        "You are a geography expert with complete world knowledge.\n"
        "Given any location — city, state, province, country, or region — "
        "identify which country it belongs to.\n\n"
        "Rules:\n"
        "- City or town -> its country  (Oklahoma City -> United States, Noida -> India, Osaka -> Japan, Lyon -> France)\n"
        "- State or province -> its country  (Oklahoma -> United States, Bavaria -> Germany, Ontario -> Canada, Maharashtra -> India)\n"
        "- Already a country name -> return it exactly in English\n"
        "- Truly unidentifiable non-geographic term -> return Global\n\n"
        "Location: \"" + area.strip() + "\"\n\n"
        "Respond with ONLY this JSON and absolutely nothing else:\n"
        "{\"country\": \"<country name in English>\"}"
    )

    try:
        response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=prompt
        )
        raw = response.text.strip()
        raw = re.sub(r"```[a-zA-Z]*", "", raw).replace("```", "").strip()
        match = re.search(r'\{[^{}]+\}', raw, re.DOTALL)
        parsed = json.loads(match.group() if match else raw)
        country = parsed.get("country", "").strip()

        if country and country in COUNTRY_TO_REGION:
            region = COUNTRY_TO_REGION[country]
            return {
                "Requesting Countries": country,
                "Requesting Regions":   region,
                "Bill2Country":         country
            }

        if country and country != "Global":
            # Country recognised by Gemini but not yet in our map — still return it
            return {
                "Requesting Countries": country,
                "Requesting Regions":   "Global",
                "Bill2Country":         country
            }

    except Exception:
        pass

    # Absolute fallback — only if Gemini call itself fails (e.g. network error)
    return {
        "Requesting Countries": area.strip().title(),
        "Requesting Regions":   "Global",
        "Bill2Country":         area.strip().title()
    }


