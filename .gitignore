# =========================================================
# SESSION STATE
# =========================================================

session_state = {"captured": {}, "completed": []}

def reset_session():
    session_state["captured"] = {}
    session_state["completed"] = []

def get_next_field():
    for field in MANDATORY_FIELDS:
        if field["key"] not in session_state["completed"]:
            return field
    return None

