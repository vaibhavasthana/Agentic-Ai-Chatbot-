"""
Demand Creation Chatbot - Final
=================================
- Layer 0: Instant hardcoded lookup for 80+ cities/states/countries
- Layer 1: Gemini 2.5 Flash for anything not in lookup
- Layer 2: Gemini fallback with simpler prompt
- Layer 3: Safe absolute fallback
- UI: SharePoint & Google Sites compatible
"""

from dotenv import load_dotenv
load_dotenv()

from flask import Flask, request, jsonify, render_template_string
